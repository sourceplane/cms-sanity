# https://github.com/vercel/next.js/tree/canary/examples/cms-sanity#using-the-sanity-cli
# Copy to .env.local (git-ignored) for `next dev`. The project id and dataset
# are build-time public values: `next build` inlines them into the server and
# the Studio bundles, so the build that deploys must have them (the Orun build
# exports them from the product's secrets, apps/web/component.yaml). Unset,
# the build script substitutes `placeholder` for both so the credential-free
# build in Checks still runs — the Worker then has no project to read from.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# The read token (draft mode / live preview) is read at request time. Here it
# serves `next dev`; the Worker reads it as a secret — see .dev.vars.example.
SANITY_API_READ_TOKEN=
# Optional. Cloudflare Web Analytics beacon token (stands in for Vercel Speed
# Insights). Unset → no script is rendered.
NEXT_PUBLIC_CF_BEACON_TOKEN=
